# --- MHOC chatbot (server-side only: read by api/chat.js, never bundled into the browser) ---
# Which provider answers: groq | gemini
LLM_PROVIDER=groq
# If the primary provider fails, automatically try the other one (true | false)
LLM_FALLBACK=true
# Groq key: https://console.groq.com/keys  (comma-separate several keys to rotate)
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Public (browser) variables ---VITE_SERVICE_ID=your_service_id_here
VITE_TEMPLATE_ID=your_template_id_here
VITE_PUBLIC_KEY=your_public_key_here

# Resume PDFs (Google Drive or direct links)
VITE_RESUME_BACKEND_URL=https://drive.google.com/file/d/1tSktDbgEJZuYuNmYAKmGWH3O18-wOQSD/view?usp=sharing
VITE_RESUME_AI_URL=https://drive.google.com/file/d/1YXpcJlmtNrcKvvyWpb4XfAIIiNE0lFvo/view?usp=sharing

# Optional legacy single resume (fallback if role URLs unset)
# VITE_RESUME_URL=/resume.pdf
